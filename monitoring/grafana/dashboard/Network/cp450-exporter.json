                          {
                            "type": "value",
                            "options": {
                              "0": {
                                "text": "Disabled",
                                "color": "gray",
                                "index": 0
                              },
                              "1": {
                                "text": "Enabled",
                                "color": "green",
                                "index": 1
                              }
                            }
                          }
                        ]
                      },
                      {
                        "id": "custom.cellOptions",
                        "value": {
                          "type": "color-text"
                        }
                      }
                    ]
                  }
                ]
              },
              "options": {
                "cellHeight": "sm",
                "enablePagination": true,
                "showHeader": true,
                "sortBy": [
                  {
                    "desc": false,
                    "displayName": "Index"
                  }
                ]
              }
            },
            "version": "13.3.2"
          }
        }
      }
