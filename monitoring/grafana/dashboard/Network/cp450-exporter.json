      "panel-21": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "${DS_PROMETHEUS}"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "expr": "min by (target) (max by (target, mac) (cp450_wifi_station_signal_percent{job=\"cp450\",target=\"$target\"}))",
                        "format": "time_series",
                        "instant": true,
                        "legendFormat": "{{target}}",
                        "range": false
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Lowest signal quality percentage reported by the device across its associated Wi-Fi stations.",
          "id": 21,
          "links": [],
          "title": "Weakest station signal quality",
          "vizConfig": {
            "group": "gauge",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "thresholds"
                  },
                  "decimals": 0,
                  "min": 0,
                  "max": 100,
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "blue",
                        "value": null
                      }
                    ]
                  },
                  "unit": "percent"
                },
                "overrides": []
              },
              "options": {
                "orientation": "auto",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "shape": "gauge",
                "showThresholdLabels": false,
                "showThresholdMarkers": false,
                "sizing": "auto"
              }
            },
            "version": "13.3.2"
          }
        }
      },
      "panel-11": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "${DS_PROMETHEUS}"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "expr": "max by (target, mac) (cp450_wifi_station_signal_dbm{job=\"cp450\",target=\"$target\"})",
                        "format": "time_series",
                        "instant": false,
                        "interval": "30s",
                        "legendFormat": "{{mac}}",
                        "range": true
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Received signal strength for each station associated with the selected CP450 targets.",
          "id": 11,
          "links": [],
          "title": "Station signal history",
          "vizConfig": {
            "group": "timeseries",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "palette-classic"
                  },
                  "custom": {
                    "drawStyle": "line",
                    "fillOpacity": 8,
                    "lineInterpolation": "linear",
                    "lineWidth": 2,
                    "showPoints": "never",
                    "spanNulls": false
                  },
                  "unit": "dBm",
                  "decimals": 0
                },
                "overrides": []
              },
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "none"
                }
              }
            },
            "version": "13.3.2"
          }
        }
      },
      "panel-9": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "${DS_PROMETHEUS}"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "expr": "max by (target) (rate(cp450_wifi_received_packets_total{job=\"cp450\",target=\"$target\"}[$__rate_interval]))",
                        "format": "time_series",
                        "instant": false,
                        "interval": "30s",
                        "legendFormat": "RX",
                        "range": true
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "${DS_PROMETHEUS}"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "expr": "max by (target) (rate(cp450_wifi_transmitted_packets_total{job=\"cp450\",target=\"$target\"}[$__rate_interval]))",
                        "format": "time_series",
                        "instant": false,
                        "interval": "30s",
                        "legendFormat": "TX",
                        "range": true
                      },
                      "version": "v0"
                    },
                    "refId": "B"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Packets received and transmitted per second by the Wi-Fi radio.",
          "id": 9,
          "links": [],
          "title": "Wi-Fi packet rate",
          "vizConfig": {
            "group": "timeseries",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "palette-classic"
                  },
                  "custom": {
                    "drawStyle": "line",
                    "fillOpacity": 8,
                    "lineInterpolation": "linear",
                    "lineWidth": 2,
                    "showPoints": "never",
                    "spanNulls": false
                  },
                  "unit": "suffix: pkt/s",
                  "min": 0
                },
                "overrides": []
              },
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "none"
                }
              }
            },
            "version": "13.3.2"
          }
        }
      },
      "panel-22": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "${DS_PROMETHEUS}"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "expr": "max by (target, mac, ip, mode, bandwidth) (cp450_wifi_station_info{job=\"cp450\",target=\"$target\"}) * on (target, mac) group_left max by (target, mac) (cp450_wifi_station_signal_dbm{job=\"cp450\",target=\"$target\"})",
                        "format": "table",
                        "instant": true,
                        "range": false
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": [
                {
                  "group": "filterFieldsByName",
                  "kind": "Transformation",
                  "spec": {
                    "options": {
                      "include": {
                        "names": [
                          "mac",
                          "ip",
                          "mode",
                          "bandwidth",
                          "Value"
                        ]
                      }
                    }
                  }
                },
                {
                  "group": "organize",
                  "kind": "Transformation",
                  "spec": {
                    "options": {
                      "excludeByName": {},
                      "indexByName": {
                        "mac": 0,
                        "ip": 1,
                        "mode": 2,
                        "bandwidth": 3,
                        "Value": 4
                      },
                      "renameByName": {
                        "mac": "Station MAC",
                        "ip": "IP address",
                        "mode": "PHY mode",
                        "bandwidth": "Channel width",
                        "Value": "Signal"
                      }
                    }
                  }
                }
              ]
            }
          },
          "description": "Current details and received signal strength for each associated station.",
          "id": 22,
          "links": [],
          "title": "Station details",
          "vizConfig": {
            "group": "table",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {},
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Signal"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "dBm"
                      },
                      {
                        "id": "decimals",
                        "value": 0
                      }
                    ]
                  }
                ]
              },
              "options": {
                "cellHeight": "sm",
                "enablePagination": true,
                "showHeader": true,
                "sortBy": [
                  {
                    "desc": false,
                    "displayName": "Station MAC"
                  }
                ]
              }
            },
            "version": "13.3.2"
          }
        }
      },
      "panel-12": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "${DS_PROMETHEUS}"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "expr": "label_join(max by (target, index, ssid) (cp450_wifi_clients{job=\"cp450\",target=\"$target\"}) and on (target, index) (max by (target, index) (cp450_wifi_ssid_enabled{job=\"cp450\",target=\"$target\"}) == 1), \"ssid_slot\", \" / \", \"index\", \"ssid\")",
                        "format": "table",
                        "instant": true,
                        "range": false
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": [
                {
                  "group": "filterFieldsByName",
                  "kind": "Transformation",
                  "spec": {
                    "options": {
                      "include": {
                        "names": [
                          "ssid_slot",
                          "Value"
                        ]
                      }
                    }
                  }
                },
                {
                  "group": "organize",
                  "kind": "Transformation",
                  "spec": {
                    "options": {
                      "excludeByName": {},
                      "indexByName": {
                        "ssid_slot": 0,
                        "Value": 1
                      },
                      "renameByName": {
                        "ssid_slot": "SSID",
                        "Value": "Clients"
                      }
                    }
                  }
                }
              ]
            }
          },
          "description": "Client count for each enabled SSID at the end of the selected time range.",
          "id": 12,
          "links": [],
          "title": "Clients per SSID",
          "vizConfig": {
            "group": "barchart",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "fixed",
                    "fixedColor": "blue"
                  },
                  "custom": {
                    "fillOpacity": 85,
                    "lineWidth": 0
                  },
                  "decimals": 0,
                  "min": 0,
                  "unit": "none"
                },
                "overrides": []
              },
              "options": {
                "barRadius": 0.1,
                "barWidth": 0.7,
                "groupWidth": 0.65,
                "legend": {
                  "showLegend": false
                },
                "orientation": "horizontal",
                "showValue": "always",
                "stacking": "none",
                "tooltip": {
                  "mode": "single",
                  "sort": "none"
                },
                "xField": "SSID"
              }
            },
            "version": "13.3.2"
          }
        }
      },
      "panel-14": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "${DS_PROMETHEUS}"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "expr": "max by (target, index, ssid, authentication, encryption) (cp450_wifi_ssid_info{job=\"cp450\",target=\"$target\"}) * on (target, index) group_left max by (target, index) (cp450_wifi_ssid_enabled{job=\"cp450\",target=\"$target\"})",
                        "format": "table",
                        "instant": true,
                        "range": false
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": [
                {
                  "group": "filterFieldsByName",
                  "kind": "Transformation",
                  "spec": {
                    "options": {
                      "include": {
                        "names": [
                          "index",
                          "ssid",
                          "Value",
                          "authentication",
                          "encryption"
                        ]
                      }
                    }
                  }
                },
                {
                  "group": "organize",
                  "kind": "Transformation",
                  "spec": {
                    "options": {
                      "excludeByName": {},
                      "indexByName": {
                        "index": 0,
                        "ssid": 1,
                        "Value": 2,
                        "authentication": 3,
                        "encryption": 4
                      },
                      "renameByName": {
                        "index": "Index",
                        "ssid": "SSID",
                        "Value": "State",
                        "authentication": "Authentication",
                        "encryption": "Encryption"
                      }
                    }
                  }
                }
              ]
            }
          },
          "description": "",
          "id": 14,
          "links": [],
          "title": "SSID configuration",
          "vizConfig": {
            "group": "table",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
